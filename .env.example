# Enrichment API keys
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
IPINFO_API_KEY=
OTX_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
URLSCAN_API_KEY=
MALWAREBAZAAR_API_KEY=

# Optional — defaults shown
PORT=8080
CACHE_TTL_SECONDS=3600

# URLScan sends a submitted URL to a third party. Keep disabled unless an
# operator deliberately enables explicit, user-consented active submissions.
URLSCAN_ACTIVE_SUBMISSION=false
URLSCAN_VISIBILITY=unlisted
