# Enrichment API keys
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
IPINFO_API_KEY=
OTX_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
URLSCAN_API_KEY=
MALWAREBAZAAR_API_KEY=

# Optional — defaults shown
PORT=8080
CACHE_TTL_SECONDS=3600

# Production only: use a unique secret configured in Cloudflare Transform
# Rules. Leave blank for local development; never commit a real value.
CLOUDFLARE_ORIGIN_SECRET=

# URLScan sends a submitted URL to a third party. Keep disabled unless an
# operator deliberately enables explicit, user-consented active submissions.
URLSCAN_ACTIVE_SUBMISSION=false
URLSCAN_VISIBILITY=unlisted

# Disabled by default. Never enable on the public backend; reserved for an
# isolated, owner-controlled lab with fixed private target CIDRs only.
SERVER_SCANNER_ENABLED=false
SERVER_SCANNER_ALLOWED_TARGETS=
